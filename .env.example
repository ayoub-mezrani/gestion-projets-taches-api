# Numero du port sur lequel le serveur va ecouter
PORT=5000

# URL de connexion a MongoDB (local ou MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/gestion_projets_taches

# Cle secrete utilisee pour signer les tokens JWT (mets une valeur longue et aleatoire)
JWT_SECRET=remplace_moi_par_une_cle_secrete_longue_et_aleatoire

# Duree de validite du token JWT
JWT_EXPIRES_IN=1d

# Environnement (development / production)
NODE_ENV=development
